113 7 6 8               /*            Q -> Q            */
119 1 1 8               /*            W -> W            */
101 1 6 8               /*            E -> E            */
114 2 1 8               /*            R -> R            */
116 2 6 8               /*            T -> T            */
121 3 1 8               /*            Y -> Y            */
117 3 6 8               /*            U -> U            */
105 4 1 8               /*            I -> I            */
111 4 6 8               /*            O -> O            */
112 5 1 8               /*            P -> P            */
97 1 2 8                /*            A -> A            */
115 1 5 8               /*            S -> S            */
100 2 2 8               /*            D -> D            */
102 2 5 8               /*            F -> F            */
103 3 2 8               /*            G -> G            */
104 3 5 8               /*            H -> H            */
106 4 2 8               /*            J -> J            */
107 4 5 8               /*            K -> K            */
108 5 2 8               /*            L -> L            */
122 1 4 8               /*            Z -> Z            */
120 2 7 8               /*            X -> X            */
99 2 4 8                /*            C -> C            */
118 3 7 8               /*            V -> V            */
