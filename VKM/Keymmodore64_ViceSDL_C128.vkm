# |Bit 10| ALT | KP 0| KP .|A.UP |A.DWN|A.LFT|A.RGT|NOSCR|

290 		10 0 8
256 		10 1 8
266	  		10 2 8
273			10 3 8
281         10 4 8
276			10 5 8
279         10 6 8
267			10 7 8  	/*     Numpad / -> NO SCROLL    */

# Numbers
49 7 0 8                /*            1 -> 1            */
50 7 3 8                /*            2 -> 2            */
51 1 0 8                /*            3 -> 3            */
52 1 3 8                /*            4 -> 4            */
53 2 0 8                /*            5 -> 5            */
