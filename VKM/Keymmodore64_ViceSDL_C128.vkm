283 		8 0 8       /*            F2 -> HELP            */
264 		8 1 8
261 		8 2 8
292 		8 3 8  		/*            F11 -> TAB            */
258		 	8 4 8
260 		8 5 8
263			8 6 8
257		 	8 7 8

